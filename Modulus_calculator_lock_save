</div>

<!-- STATUS BAR -->
<div class="statusbar">
  <span id="status">▶ AWAITING INPUT — ENTER DATA AND EXECUTE PLOT</span>
  <button id="btnRZ" class="xc-btn" onclick="resetZoom()" style="display:none">↺ RESET ZOOM</button>
  <button class="xc-btn" onclick="resetPts()">✕ RESET PTS</button>
</div>

<!-- CHART -->
<div id="chartWrap">
  <canvas id="cv"></canvas>
</div>
<div class="hint" id="hint" style="display:none">[ SCROLL: ZOOM ] [ DRAG: PAN ] [ CLICK: SELECT POINT ]</div>

<!-- DATA TABLE -->
<div style="font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--xc-dimtext);margin-top:8px;margin-bottom:3px">▶ DATA REGISTRY</div>
<div class="tbl">
  <table><thead><tr><th>#</th><th>Strain ε (%)</th><th>Stress σ (MPa)</th></tr></thead>
  <tbody id="tb"></tbody></table>
</div>

<script>
var cv  = document.getElementById('cv');
var cx  = cv.getContext('2d');
var showDots  = false;
var fixedMode = false;
var M = {l:88, r:20, t:20, b:62};
var pxPerUnit = 50;
var vX={min:0,max:10}, vY={min:0,max:10};
var fX={min:0,max:10}, fY={min:0,max:10};
var raw=[], sel=[null,null], mode=0, spPts=[];
var panning=false, panStart=null, panSnap=null;

// ── sizing ────────────────────────────────────────────────
function sizeCanvas(){
  var wrap=document.getElementById('chartWrap');
  if(fixedMode){
    var W=Math.round(fX.max*pxPerUnit)+M.l+M.r;
    var H=Math.round(fY.max*pxPerUnit)+M.t+M.b;
    cv.width=Math.max(W,400); cv.height=Math.max(H,300);
    wrap.style.height=Math.min(cv.height,700)+'px';
    wrap.style.overflowX='auto'; wrap.style.overflowY='auto';
  } else {
    cv.width=wrap.offsetWidth||1200; cv.height=640;
    wrap.style.height='640px';
    wrap.style.overflowX='hidden'; wrap.style.overflowY='hidden';
  }
}
window.addEventListener('resize',function(){ if(!fixedMode){sizeCanvas();draw();} });

// ── coords ────────────────────────────────────────────────
function vx2p(v){ return fixedMode?M.l+v*pxPerUnit:M.l+(v-vX.min)/(vX.max-vX.min)*(cv.width-M.l-M.r); }
function vy2p(v){ return fixedMode?cv.height-M.b-v*pxPerUnit:cv.height-M.b-(v-vY.min)/(vY.max-vY.min)*(cv.height-M.t-M.b); }
function dx2v(p){ return fixedMode?(p-M.l)/pxPerUnit:vX.min+(p-M.l)/(cv.width-M.l-M.r)*(vX.max-vX.min); }
function dy2v(p){ return fixedMode?(cv.height-M.b-p)/pxPerUnit:vY.min+(cv.height-M.b-p)/(cv.height-M.t-M.b)*(vY.max-vY.min); }

// ── controls ──────────────────────────────────────────────
function getThick(){ return Math.max(0.1,parseFloat(document.getElementById('slNum').value)||1); }
function onSlider(){ document.getElementById('slNum').value=parseFloat(document.getElementById('sl').value).toFixed(1); draw(); }
function onNum(){ document.getElementById('sl').value=Math.min(10,Math.max(0.1,parseFloat(document.getElementById('slNum').value)||1)); draw(); }
function toggleDots(){ showDots=!showDots; document.getElementById('btnDots').className=showDots?'xc-btn tog on':'xc-btn tog'; draw(); }
function toggleFixed(){ fixedMode=!fixedMode; document.getElementById('btnFixed').className=fixedMode?'xc-btn tog fixed-on':'xc-btn tog'; pxPerUnit=50; sizeCanvas(); draw(); }

// ── zoom / pan ────────────────────────────────────────────
cv.addEventListener('wheel',function(e){
  e.preventDefault();
  if(!raw.length) return;
  var f=e.deltaY>0?1/1.12:1.12;
  if(fixedMode){ pxPerUnit=Math.max(5,Math.min(2000,pxPerUnit*f)); sizeCanvas(); draw(); }
  else{
    var r=cv.getBoundingClientRect();
    var mx=dx2v(e.clientX-r.left),my=dy2v(e.clientY-r.top);
    var g=e.deltaY>0?1.13:1/1.13;
    vX={min:mx+(vX.min-mx)*g,max:mx+(vX.max-mx)*g};
    vY={min:my+(vY.min-my)*g,max:my+(vY.max-my)*g};
    draw();
  }
},{passive:false});
cv.addEventListener('mousedown',function(e){
  if(!raw.length) return;
  panning=false; panStart={x:e.clientX,y:e.clientY};
  if(!fixedMode) panSnap={x0:vX.min,x1:vX.max,y0:vY.min,y1:vY.max};
});
cv.addEventListener('mousemove',function(e){
  if(!panStart) return;
  var dx=e.clientX-panStart.x,dy=e.clientY-panStart.y;
  if(Math.abs(dx)>3||Math.abs(dy)>3) panning=true;
  if(!panning||fixedMode) return;
  cv.style.cursor='crosshair';
  var xR=panSnap.x1-panSnap.x0,yR=panSnap.y1-panSnap.y0;
  vX={min:panSnap.x0-dx/cv.width*xR,max:panSnap.x1-dx/cv.width*xR};
  vY={min:panSnap.y0+dy/cv.height*yR,max:panSnap.y1+dy/cv.height*yR};
  draw();
});
window.addEventListener('mouseup',function(){ panStart=null; setTimeout(function(){panning=false;},50); });
cv.addEventListener('click',function(e){
  if(panning||!raw.length) return;
  var r=cv.getBoundingClientRect();
  var mx=e.clientX-r.left,my=e.clientY-r.top;
  var best=-1,bestD=Infinity;
  for(var i=0;i<raw.length;i++){
    var d=Math.hypot(vx2p(raw[i].e)-mx,vy2p(raw[i].s)-my);
    if(d<bestD){bestD=d;best=i;}
  }
  if(best>=0&&bestD<22) pick(best);
});

// ── ticks ─────────────────────────────────────────────────
function niceTicks(min,max,maxCount){
  maxCount=maxCount||12;
  var steps=[0.00001,0.00002,0.00005,0.0001,0.0002,0.0005,0.001,0.002,0.005,
             0.01,0.02,0.05,0.1,0.2,0.5,1,2,5,10,20,25,50,100,200,500,1000,2000,5000,10000];
  var step=1;
  for(var k=0;k<steps.length;k++){
    step=steps[k];
    if(Math.ceil((max-min)/step)+1<=maxCount) break;
  }
  var dec=Math.max(0,-Math.floor(Math.log10(step))+1);
  var start=Math.floor(min/step)*step;
  var ticks=[];
  for(var v=start;v<=max+step*0.001;v+=step) ticks.push(parseFloat(v.toFixed(dec)));
  return {step:step,ticks:ticks};
}
function fmt(v){
  if(v===0) return '0';
  if(Math.abs(v)<0.0001) return v.toExponential(3);
  if(Math.abs(v)>=1e7)   return v.toExponential(3);
  return parseFloat(v.toPrecision(7)).toString();
}

// ── DRAW ─────────────────────────────────────────────────
function draw(){
  var W=cv.width,H=cv.height;
  cx.clearRect(0,0,W,H);

  // background with subtle scanline via canvas
  cx.fillStyle='#08100a'; cx.fillRect(0,0,W,H);

  var px0=M.l,px1=W-M.r,py0=M.t,py1=H-M.b;

  // plot area
  cx.fillStyle='#060e04'; cx.fillRect(px0,py0,px1-px0,py1-py0);

  // subtle green phosphor glow on plot area
  var grd=cx.createRadialGradient((px0+px1)/2,(py0+py1)/2,10,(px0+px1)/2,(py0+py1)/2,Math.max(px1-px0,py1-py0)/1.5);
  grd.addColorStop(0,'rgba(72,168,48,0.04)');
  grd.addColorStop(1,'rgba(0,0,0,0)');
  cx.fillStyle=grd; cx.fillRect(px0,py0,px1-px0,py1-py0);

  // visible range
  var xMin,xMax,yMin,yMax;
  if(fixedMode){xMin=0;xMax=(px1-px0)/pxPerUnit;yMin=0;yMax=(py1-py0)/pxPerUnit;}
  else{xMin=vX.min;xMax=vX.max;yMin=vY.min;yMax=vY.max;}

  // Fixed mode: one tick every ~70px so labels never crowd.
  // Zooming in (bigger pxPerUnit -> bigger canvas -> more pixels) allows more ticks.
  var fixedTickTarget = fixedMode ? Math.max(4, Math.min(25, Math.round((px1-px0)/70))) : 14;
  var xT=niceTicks(xMin,xMax,fixedTickTarget);
  var yT=niceTicks(yMin,yMax,fixedTickTarget);

  if(fixedMode){
    var cs=Math.max(xT.step,yT.step);
    var dec=Math.max(0,-Math.floor(Math.log10(cs))+1);
    var mk=function(min,max,s,d){var t=[],v=Math.floor(min/s)*s;for(;v<=max+s*0.001;v+=s)t.push(parseFloat(v.toFixed(d)));return t;};
    xT={step:cs,ticks:mk(xMin,xMax,cs,dec)};
    yT={step:cs,ticks:mk(yMin,yMax,cs,dec)};
  }

  cx.setLineDash([]);

  // X grid + labels
  cx.font='bold 15px "Share Tech Mono",monospace';
  for(var i=0;i<xT.ticks.length;i++){
    var v=xT.ticks[i];
    var px=vx2p(v);
    if(px<px0-1||px>px1+1) continue;
    // grid line — dim green phosphor
    cx.strokeStyle='rgba(72,168,48,0.12)'; cx.lineWidth=1;
    cx.beginPath(); cx.moveTo(px,py0); cx.lineTo(px,py1); cx.stroke();
    // tick
    cx.strokeStyle='#3a6020'; cx.lineWidth=2;
    cx.beginPath(); cx.moveTo(px,py1); cx.lineTo(px,py1+8); cx.stroke();
    // label
    cx.fillStyle='#a8d458'; cx.textAlign='center';
    cx.fillText(fmt(v),px,py1+24);
  }

  // Y grid + labels
  cx.font='bold 15px "Share Tech Mono",monospace';
  for(var i=0;i<yT.ticks.length;i++){
    var v=yT.ticks[i];
    var py=vy2p(v);
    if(py<py0-1||py>py1+1) continue;
    cx.strokeStyle='rgba(72,168,48,0.12)'; cx.lineWidth=1;
    cx.beginPath(); cx.moveTo(px0,py); cx.lineTo(px1,py); cx.stroke();
    cx.strokeStyle='#3a6020'; cx.lineWidth=2;
    cx.beginPath(); cx.moveTo(px0,py); cx.lineTo(px0-8,py); cx.stroke();
    cx.fillStyle='#a8d458'; cx.textAlign='right';
    cx.fillText(fmt(v),px0-12,py+5);
  }

  // origin crosshair in fixed mode
  if(fixedMode){
    var ox=vx2p(0),oy=vy2p(0);
    if(ox>=px0&&ox<=px1&&oy>=py0&&oy<=py1){
      cx.strokeStyle='rgba(160,80,240,0.5)'; cx.lineWidth=1; cx.setLineDash([4,4]);
      cx.beginPath(); cx.moveTo(ox,py0); cx.lineTo(ox,py1); cx.stroke();
      cx.beginPath(); cx.moveTo(px0,oy); cx.lineTo(px1,oy); cx.stroke();
      cx.setLineDash([]);
    }
  }

  // beveled border around plot area
  cx.setLineDash([]);
  // outer dark
  cx.strokeStyle='#000'; cx.lineWidth=2;
  cx.strokeRect(px0-1,py0-1,px1-px0+2,py1-py0+2);
  // inner highlight top-left
  cx.strokeStyle='#2a5018'; cx.lineWidth=1;
  cx.beginPath(); cx.moveTo(px0,py1); cx.lineTo(px0,py0); cx.lineTo(px1,py0); cx.stroke();
  // inner shadow bottom-right
  cx.strokeStyle='#0a1206'; cx.lineWidth=1;
  cx.beginPath(); cx.moveTo(px0,py1); cx.lineTo(px1,py1); cx.lineTo(px1,py0); cx.stroke();

  // axis labels
  cx.fillStyle='#72a830'; cx.font='bold 13px "Share Tech Mono",monospace'; cx.textAlign='center';
  cx.fillText('ε (%)',px0+(px1-px0)/2,H-5);
  cx.save(); cx.translate(14,py0+(py1-py0)/2); cx.rotate(-Math.PI/2);
  cx.fillText('σ (MPa)',0,0); cx.restore();

  // fixed mode overlay
  if(fixedMode){
    cx.fillStyle='rgba(100,40,200,0.08)'; cx.fillRect(px0,py0,px1-px0,py1-py0);
    cx.fillStyle='#8060d0'; cx.font='bold 11px "Share Tech Mono",monospace'; cx.textAlign='right';
    cx.fillText('⊕ LOCK 1%=1MPa ['+pxPerUnit.toFixed(0)+'px/u]',px1-6,py0+16);
  }

  if(!raw.length) return;

  // clip to plot
  cx.save();
  cx.beginPath(); cx.rect(px0,py0,px1-px0,py1-py0); cx.clip();

  // tangent line — amber dashed
  if(sel[0]&&sel[1]){
    var ab=[sel[0],sel[1]].slice().sort(function(a,b){return a.e-b.e;});
    var pa=ab[0],pb=ab[1],slp=(pb.s-pa.s)/(pb.e-pa.e);
    var span=(fixedMode?xMax:vX.max)-(fixedMode?xMin:vX.min);
    var x0=pa.e-span*0.15,x1=pb.e+span*0.15;
    cx.strokeStyle='#c8a020'; cx.lineWidth=1.5; cx.setLineDash([6,3]);
    cx.beginPath();
    cx.moveTo(vx2p(x0),vy2p(pa.s+slp*(x0-pa.e)));
    cx.lineTo(vx2p(x1),vy2p(pa.s+slp*(x1-pa.e)));
    cx.stroke(); cx.setLineDash([]);
  }

  // spline — phosphor green glow
  if(spPts.length>1){
    var lw=getThick();
    // glow layer
    cx.strokeStyle='rgba(72,168,48,0.25)'; cx.lineWidth=lw+4;
    cx.lineJoin='round'; cx.lineCap='round'; cx.setLineDash([]);
    cx.beginPath();
    var lpx=null,lpy=null,started=false;
    for(var i=0;i<spPts.length;i++){
      var ppx=vx2p(spPts[i].x)|0,ppy=vy2p(spPts[i].y)|0;
      if(ppx===lpx&&ppy===lpy) continue; lpx=ppx;lpy=ppy;
      if(!started){cx.moveTo(ppx,ppy);started=true;}else cx.lineTo(ppx,ppy);
    }
    cx.stroke();
    // main line
    cx.strokeStyle='#a8d458'; cx.lineWidth=lw;
    cx.beginPath(); started=false; lpx=null; lpy=null;
    for(var i=0;i<spPts.length;i++){
      var ppx=vx2p(spPts[i].x)|0,ppy=vy2p(spPts[i].y)|0;
      if(ppx===lpx&&ppy===lpy) continue; lpx=ppx;lpy=ppy;
      if(!started){cx.moveTo(ppx,ppy);started=true;}else cx.lineTo(ppx,ppy);
    }
    cx.stroke();
  }

  // dots
  if(showDots){
    for(var i=0;i<raw.length;i++){
      var is1=sel[0]&&sel[0].i===i,is2=sel[1]&&sel[1].i===i;
      if(!is1&&!is2){
        cx.beginPath(); cx.arc(vx2p(raw[i].e),vy2p(raw[i].s),2,0,Math.PI*2);
        cx.fillStyle='rgba(168,212,88,0.5)'; cx.fill();
      }
    }
  }

  // selected points — pixelated diamond markers
  function drawMarker(px,py,color,label){
    var s=8;
    cx.fillStyle=color;
    cx.beginPath();
    cx.moveTo(px,py-s); cx.lineTo(px+s,py); cx.lineTo(px,py+s); cx.lineTo(px-s,py);
    cx.closePath(); cx.fill();
    cx.strokeStyle='#fff'; cx.lineWidth=1; cx.stroke();
    cx.fillStyle='#fff'; cx.font='bold 10px "Share Tech Mono",monospace'; cx.textAlign='center';
    cx.fillText(label,px,py+4);
  }
  if(sel[0]) drawMarker(vx2p(sel[0].e),vy2p(sel[0].s),'#72a830','α');
  if(sel[1]) drawMarker(vx2p(sel[1].e),vy2p(sel[1].s),'#b83020','β');

  cx.restore();
}

// ── Catmull-Rom ───────────────────────────────────────────
function catmullRom(pts){
  var MAX=400,src=pts;
  if(pts.length>MAX){
    var o=[],s=pts.length/MAX;
    for(var k=0;k<MAX;k++) o.push(pts[Math.round(k*s)]);
    o.push(pts[pts.length-1]); src=o;
  }
  if(src.length<2) return src;
  var n=6,g0={x:2*src[0].x-src[1].x,y:2*src[0].y-src[1].y};
  var gN={x:2*src[src.length-1].x-src[src.length-2].x,y:2*src[src.length-1].y-src[src.length-2].y};
  var a=[g0].concat(src,[gN]),out=[];
  for(var i=1;i<a.length-2;i++){
    var p0=a[i-1],p1=a[i],p2=a[i+1],p3=a[i+2];
    for(var j=(i===1?0:1);j<=n;j++){
      var t=j/n,t2=t*t,t3=t2*t;
      out.push({
        x:.5*((2*p1.x)+(-p0.x+p2.x)*t+(2*p0.x-5*p1.x+4*p2.x-p3.x)*t2+(-p0.x+3*p1.x-3*p2.x+p3.x)*t3),
        y:.5*((2*p1.y)+(-p0.y+p2.y)*t+(2*p0.y-5*p1.y+4*p2.y-p3.y)*t2+(-p0.y+3*p1.y-3*p2.y+p3.y)*t3)
      });
    }
  }
  return out;
}

function nums(t){ return t.trim().split(/[\s,;]+/).map(Number).filter(isFinite); }

// ── plot ──────────────────────────────────────────────────
function doPlot(){
  var en=nums(document.getElementById('eIn').value);
  var sn=nums(document.getElementById('sIn').value);
  var msg=document.getElementById('msg');
  if(!en.length||!sn.length){msg.textContent='! MISSING DATA';msg.style.color='#e04030';return;}
  if(en.length!==sn.length){msg.textContent='! MISMATCH '+en.length+'/'+sn.length;msg.style.color='#e04030';return;}
  if(en.length<2){msg.textContent='! NEED ≥2 PTS';msg.style.color='#e04030';return;}
  msg.textContent='◈ '+en.length+' PTS LOADED'; msg.style.color='#a8d458';

  raw=en.map(function(e,i){return{e:e,s:sn[i]};}).sort(function(a,b){return a.e-b.e;});
  sel=[null,null]; mode=0;
  spPts=catmullRom(raw.map(function(p){return{x:p.e,y:p.s};}));

  var xs=raw.map(function(p){return p.e;});
  var ys=raw.map(function(p){return p.s;});
  var xt=niceTicks(0,Math.max.apply(null,xs)*1.08,14);
  var yt=niceTicks(0,Math.max.apply(null,ys)*1.08,12);
  fX={min:0,max:xt.ticks[xt.ticks.length-1]};
  fY={min:0,max:yt.ticks[yt.ticks.length-1]};
  vX={min:fX.min,max:fX.max}; vY={min:fY.min,max:fY.max};
  pxPerUnit=50; sizeCanvas(); buildTable(); draw();
  document.getElementById('btnRZ').style.display='';
  document.getElementById('hint').style.display='';
  setStatus('◈ TARGETING MODE — SELECT POINT ALPHA ON CHART','');
  updateCards();
}

function doDemo(){
  document.getElementById('eIn').value='0.02\n0.20\n0.50\n1.00\n1.50\n2.00\n2.50\n3.00\n3.50\n4.00\n5.00\n6.00\n7.00\n8.00\n9.00\n10.00\n11.00\n12.00\n13.00';
  document.getElementById('sIn').value='0.04\n0.40\n0.98\n1.95\n2.90\n4.20\n5.80\n7.00\n7.90\n8.30\n8.55\n8.60\n8.55\n8.50\n8.42\n8.35\n8.25\n8.15\n8.05';
  doPlot();
}

function doClear(){
  document.getElementById('eIn').value=''; document.getElementById('sIn').value='';
  raw=[]; sel=[null,null]; mode=0; spPts=[];
  document.getElementById('msg').textContent='';
  document.getElementById('tb').innerHTML='';
  ['v1','v2','vE'].forEach(function(id){document.getElementById(id).textContent='---';});
  document.getElementById('s1').textContent='SELECT ON CHART';
  document.getElementById('s2').textContent='SELECT ON CHART';
  document.getElementById('sE').textContent='MPa';
  document.getElementById('btnRZ').style.display='none';
  document.getElementById('hint').style.display='none';
  setStatus('▶ AWAITING INPUT — ENTER DATA AND EXECUTE PLOT','');
  sizeCanvas(); draw();
}

// ── save / load ───────────────────────────────────────────
function openSaveDialog(){
  var eVals=document.getElementById('eIn').value.trim();
  var sVals=document.getElementById('sIn').value.trim();
  if(!eVals||!sVals){
    document.getElementById('msg').textContent='! NO DATA';
    document.getElementById('msg').style.color='#e04030';
    return;
  }
  var defaultName='modulus_'+new Date().toISOString().slice(0,10)+'.json';
  document.getElementById('saveFilename').value=defaultName;
  var modal=document.getElementById('saveModal');
  modal.style.display='flex';
  setTimeout(function(){
    document.getElementById('saveFilename').focus();
    document.getElementById('saveFilename').select();
  },50);
}

function closeSaveDialog(){
  document.getElementById('saveModal').style.display='none';
}

function buildPayload(){
  return JSON.stringify({
    version:'modulus_v4_8',author:'Sinisa Svoger',
    saved:new Date().toISOString(),
    strain:document.getElementById('eIn').value.trim(),
    stress:document.getElementById('sIn').value.trim(),
    sel0:sel[0]?{e:sel[0].e,s:sel[0].s,i:sel[0].i}:null,
    sel1:sel[1]?{e:sel[1].e,s:sel[1].s,i:sel[1].i}:null
  },null,2);
}

function confirmSave(){
  var name=document.getElementById('saveFilename').value.trim()||'modulus_data';
  if(!name.toLowerCase().endsWith('.json')) name+='.json';
  var json=buildPayload();
  var blob=new Blob([json],{type:'application/json'});
  var msg=document.getElementById('msg');

  if(typeof window.showSaveFilePicker==='function'){
    // Modern browsers: native OS Save As dialog
    window.showSaveFilePicker({
      suggestedName: name,
      types:[{description:'Modulus JSON File',accept:{'application/json':['.json']}}],
      excludeAcceptAllOption: false
    }).then(function(handle){
      return handle.createWritable();
    }).then(function(writable){
      return writable.write(blob).then(function(){ return writable.close(); });
    }).then(function(){
      closeSaveDialog();
      msg.textContent='▼ FILE SAVED';
      msg.style.color='#70a0d8';
      setTimeout(function(){msg.textContent='';},2500);
    }).catch(function(err){
      // AbortError = user cancelled = do nothing
      if(err.name!=='AbortError'){
        // Other error = fall back to download
        downloadFallback(blob,name,msg);
      }
    });
  } else {
    // Firefox / Safari / file:// fallback
    downloadFallback(blob,name,msg);
  }
}

function downloadFallback(blob,filename,msg){
  var a=document.createElement('a');
  var url=URL.createObjectURL(blob);
  a.href=url; a.download=filename;
  document.body.appendChild(a);
  a.click();
  setTimeout(function(){ URL.revokeObjectURL(url); document.body.removeChild(a); },100);
  closeSaveDialog();
  if(msg){ msg.textContent='▼ SAVED (DOWNLOADS)'; msg.style.color='#70a0d8'; setTimeout(function(){msg.textContent='';},2500); }
}

// Close on backdrop click
document.getElementById('saveModal').addEventListener('click',function(e){
  if(e.target===this) closeSaveDialog();
});
// Keyboard shortcuts in filename field
document.getElementById('saveFilename').addEventListener('keydown',function(e){
  if(e.key==='Enter') confirmSave();
  if(e.key==='Escape') closeSaveDialog();
});


function doLoad(event){
  var file=event.target.files[0]; if(!file) return;
  var reader=new FileReader();
  reader.onload=function(e){
    try{
      var d=JSON.parse(e.target.result);
      if(!d.strain||!d.stress) throw new Error('bad');
      document.getElementById('eIn').value=d.strain;
      document.getElementById('sIn').value=d.stress;
      doPlot();
      if(d.sel0&&d.sel0.i!=null&&d.sel0.i<raw.length) sel[0]={e:raw[d.sel0.i].e,s:raw[d.sel0.i].s,i:d.sel0.i};
      if(d.sel1&&d.sel1.i!=null&&d.sel1.i<raw.length) sel[1]={e:raw[d.sel1.i].e,s:raw[d.sel1.i].s,i:d.sel1.i};
      updateCards(); draw();
      document.getElementById('msg').textContent='▲ LOADED: '+file.name.toUpperCase();
      document.getElementById('msg').style.color='#70a0d8';
      setTimeout(function(){document.getElementById('msg').textContent='';},3000);
    }catch(err){document.getElementById('msg').textContent='! READ ERROR';document.getElementById('msg').style.color='#e04030';}
    event.target.value='';
  };
  reader.readAsText(file);
}

// ── table / pick ──────────────────────────────────────────
function buildTable(){
  var tb=document.getElementById('tb'); tb.innerHTML='';
  raw.forEach(function(p,i){
    var tr=document.createElement('tr'); tr.id='r'+i;
    tr.innerHTML='<td>'+(i+1)+'</td><td>'+fmt(p.e)+'</td><td>'+fmt(p.s)+'</td>';
    (function(idx){tr.onclick=function(){pick(idx);};})(i);
    tb.appendChild(tr);
  });
}
function pick(i){
  sel[mode]={e:raw[i].e,s:raw[i].s,i:i};
  mode=mode===0?1:0;
  updateCards(); draw();
}
function resetPts(){
  sel=[null,null]; mode=0;
  setStatus(raw.length?'◈ TARGETING MODE — SELECT POINT ALPHA ON CHART':'▶ AWAITING INPUT — ENTER DATA AND EXECUTE PLOT','');
  updateCards(); draw();
}
function resetZoom(){
  pxPerUnit=50; vX={min:fX.min,max:fX.max}; vY={min:fY.min,max:fY.max};
  sizeCanvas(); draw();
}
function setStatus(txt,cls){
  var el=document.getElementById('status'); el.textContent=txt; el.className=cls||'';
}
function updateCards(){
  document.getElementById('v1').textContent=sel[0]?'ε='+fmt(sel[0].e)+'% σ='+fmt(sel[0].s):'---';
  document.getElementById('s1').textContent=sel[0]?'PT '+(sel[0].i+1):'SELECT ON CHART';
  document.getElementById('v2').textContent=sel[1]?'ε='+fmt(sel[1].e)+'% σ='+fmt(sel[1].s):'---';
  document.getElementById('s2').textContent=sel[1]?'PT '+(sel[1].i+1):'SELECT ON CHART';
  if(sel[0]&&sel[1]){
    var de=sel[1].e-sel[0].e,ds=sel[1].s-sel[0].s;
    if(Math.abs(de)<1e-14){document.getElementById('vE').textContent='Δε≈0';document.getElementById('sE').textContent='';}
    else{document.getElementById('vE').textContent=fmt((ds/de)*100)+' MPa';document.getElementById('sE').textContent='E = (Δσ/Δε) × 100';}
    setStatus('◈ MODULUS ACQUIRED — MISSION COMPLETE','ok');
  } else {
    document.getElementById('vE').textContent='---'; document.getElementById('sE').textContent='MPa';
    if(sel[0]) setStatus('▶ ALPHA LOCKED — SELECT POINT BETA TO COMPUTE','');
  }
  raw.forEach(function(_,i){
    var tr=document.getElementById('r'+i); if(!tr) return;
    tr.className=(sel[0]&&sel[0].i===i)?'s1':(sel[1]&&sel[1].i===i)?'s2':'';
  });
}

sizeCanvas(); draw();
</script>

