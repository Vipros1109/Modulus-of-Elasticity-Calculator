</div>

<!-- RESULT CARDS -->
<div class="cards">
  <div class="card">
    <div class="ctitle">▶ POINT ALPHA</div>
    <div class="cval" id="v1">---</div>
    <div class="csub" id="s1">SELECT ON CHART</div>
  </div>
  <div class="card">
    <div class="ctitle">▶ POINT BETA</div>
