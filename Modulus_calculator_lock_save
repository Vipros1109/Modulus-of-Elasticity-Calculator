<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>MODULUS ANALYZER v4.8 — X-COM TACTICAL</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap');

:root{
  --xc-bg:       #0a0f08;
  --xc-panel:    #111a0d;
  --xc-border:   #2a3d1a;
  --xc-hi:       #4a6e28;
  --xc-green:    #72a830;
  --xc-ltgreen:  #a8d458;
  --xc-dimgreen: #3a5018;
  --xc-amber:    #c8a020;
  --xc-red:      #b83020;
  --xc-ltred:    #e04030;
  --xc-blue:     #2858a0;
  --xc-ltblue:   #5898e0;
  --xc-text:     #c8d8a8;
  --xc-dimtext:  #5a7040;
  --xc-scan:     rgba(0,0,0,0.18);
}

*{box-sizing:border-box;margin:0;padding:0;image-rendering:pixelated}
html,body{background:var(--xc-bg);color:var(--xc-text);font-family:'Share Tech Mono',monospace;font-size:13px;min-width:960px}

/* ── scanline overlay ── */
body::after{
  content:'';position:fixed;inset:0;pointer-events:none;z-index:9999;
  background:repeating-linear-gradient(0deg,var(--xc-scan) 0px,var(--xc-scan) 1px,transparent 1px,transparent 3px);
}

/* ── panels ── */
.xc-panel{
  background:var(--xc-panel);
  border:2px solid var(--xc-border);
  box-shadow:inset 1px 1px 0 #3a5020,inset -1px -1px 0 #060a04,2px 2px 0 #000;
  padding:8px 10px;
  margin-bottom:8px;
}
.xc-title-bar{
  background:var(--xc-hi);
  color:var(--xc-ltgreen);
  font-size:11px;
  letter-spacing:3px;
  text-transform:uppercase;
  padding:3px 8px;
  margin:-8px -10px 8px -10px;
  border-bottom:2px solid var(--xc-border);
  display:flex;justify-content:space-between;align-items:center;
}

/* ── topbar ── */
.topbar{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;padding:6px 10px;
  background:var(--xc-dimgreen);border:2px solid var(--xc-green);
  box-shadow:inset 1px 1px 0 #4a6e28,inset -1px -1px 0 #060a04,2px 2px 0 #000;}
.app-title{font-size:18px;letter-spacing:4px;color:var(--xc-ltgreen);text-shadow:0 0 8px #72a830,0 0 2px #000;text-transform:uppercase}
.branding{text-align:right;font-size:10px;color:var(--xc-dimtext);line-height:1.7;letter-spacing:1px}
.branding b{color:var(--xc-green)}

/* ── buttons — beveled X-COM style ── */
.xc-btn{
  display:inline-block;
  font-family:'Share Tech Mono',monospace;
  font-size:12px;
  letter-spacing:1px;
  text-transform:uppercase;
  cursor:pointer;
  padding:4px 10px;
  color:var(--xc-text);
  background:var(--xc-dimgreen);
  border:none;
  outline:none;
  box-shadow:
    inset 1px 1px 0 #4a6e28,
    inset -1px -1px 0 #060a04,
    2px 2px 0 #000;
  user-select:none;
  transition:none;
  white-space:nowrap;
}
.xc-btn:hover{background:#1e3010;color:var(--xc-ltgreen)}
.xc-btn:active,
.xc-btn.pressed{
  background:#0d1a08;
  box-shadow:inset 1px 1px 0 #060a04,inset -1px -1px 0 #4a6e28,2px 2px 0 #000;
  transform:translate(1px,1px);
}
.xc-btn.primary{background:#1a3a10;color:var(--xc-ltgreen);box-shadow:inset 1px 1px 0 #4a8828,inset -1px -1px 0 #060a04,2px 2px 0 #000}
.xc-btn.primary:hover{background:#224815}
.xc-btn.danger {background:#3a0c08;color:#e06050;box-shadow:inset 1px 1px 0 #6a1c14,inset -1px -1px 0 #1a0404,2px 2px 0 #000}
.xc-btn.danger:hover{background:#4a1008}
.xc-btn.save  {background:#1a2a40;color:#70a0d8;box-shadow:inset 1px 1px 0 #2858a0,inset -1px -1px 0 #060a14,2px 2px 0 #000}
.xc-btn.save:hover{background:#1e3450}
.xc-btn.tog   {background:#0d1a08;color:var(--xc-dimtext);box-shadow:inset 1px 1px 0 #060a04,inset -1px -1px 0 #2a3d1a,2px 2px 0 #000}
.xc-btn.tog.on{background:#1e4010;color:var(--xc-ltgreen);box-shadow:inset 1px 1px 0 #4a8828,inset -1px -1px 0 #060a04,2px 2px 0 #000}
.xc-btn.tog.fixed-on{background:#2a1a40;color:#c090f8;box-shadow:inset 1px 1px 0 #6838c0,inset -1px -1px 0 #0a0414,2px 2px 0 #000}

/* ── input fields ── */
textarea,input[type=number]{
  font-family:'Share Tech Mono',monospace;font-size:12px;
  background:#060e04;color:var(--xc-ltgreen);
  border:2px solid var(--xc-border);
  box-shadow:inset 1px 1px 0 #000,inset -1px -1px 0 #2a3d1a;
  padding:5px;
  outline:none;
  resize:vertical;
}
textarea::placeholder{color:var(--xc-dimtext)}
input[type=range]{
  -webkit-appearance:none;height:10px;background:var(--xc-dimgreen);
  border:1px solid var(--xc-border);
  box-shadow:inset 1px 1px 0 #000;
  outline:none;cursor:pointer;
}
input[type=range]::-webkit-slider-thumb{
  -webkit-appearance:none;width:14px;height:14px;
  background:var(--xc-green);
  border:2px solid var(--xc-ltgreen);
  box-shadow:1px 1px 0 #000;
  cursor:pointer;
}
input[type=file]{display:none}

/* ── layout ── */
.row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px}
.controls{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-bottom:8px}
.thick-ctrl{display:flex;align-items:center;gap:6px;padding:4px 8px;
  background:#060e04;border:2px solid var(--xc-border);
  box-shadow:inset 1px 1px 0 #000,inset -1px -1px 0 #2a3d1a}

/* ── data cards ── */
.cards{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:8px}
.card{
  background:var(--xc-panel);
  border:2px solid var(--xc-border);
  box-shadow:inset 1px 1px 0 #3a5020,inset -1px -1px 0 #060a04,2px 2px 0 #000;
  padding:0;
}
.card .ctitle{
  background:var(--xc-dimgreen);color:var(--xc-dimtext);
  font-size:9px;letter-spacing:2px;text-transform:uppercase;
  padding:2px 6px;border-bottom:1px solid var(--xc-border);
}
.card .cval{font-size:14px;color:var(--xc-ltgreen);padding:4px 6px;letter-spacing:1px;word-break:break-all}
.card .csub{font-size:9px;color:var(--xc-dimtext);padding:0 6px 4px;letter-spacing:1px}
.card.result .ctitle{background:#1a3010;color:var(--xc-green)}
.card.result .cval{color:var(--xc-amber);font-size:16px}
.card.result .csub{color:#7a6020}

/* ── status bar ── */
.statusbar{
  display:flex;gap:8px;align-items:center;margin-bottom:6px;
  background:#060e04;border:2px solid var(--xc-border);
  box-shadow:inset 1px 1px 0 #000;
  padding:4px 8px;
}
#status{
  font-size:11px;letter-spacing:1px;color:var(--xc-amber);flex:1;
  text-transform:uppercase;
}
#status.ok{color:var(--xc-ltgreen)}
#status.warn{color:var(--xc-ltred)}

/* ── chart container ── */
#chartWrap{
  width:100%;overflow:auto;margin-bottom:4px;
  border:2px solid var(--xc-border);
  box-shadow:inset 1px 1px 0 #000,inset -1px -1px 0 #2a3d1a,2px 2px 0 #000;
}
canvas{display:block;cursor:crosshair}

/* ── hint ── */
.hint{font-size:10px;color:var(--xc-dimtext);text-align:center;letter-spacing:2px;
  text-transform:uppercase;margin-top:4px}

/* ── data table ── */
.tbl{
  border:2px solid var(--xc-border);
  box-shadow:inset 1px 1px 0 #000;
  max-height:140px;overflow-y:auto;margin-top:8px;
}
table{width:100%;font-size:11px;border-collapse:collapse;letter-spacing:1px}
th{
  padding:3px 8px;color:var(--xc-green);text-transform:uppercase;letter-spacing:2px;
  border-bottom:1px solid var(--xc-border);text-align:left;
  background:var(--xc-dimgreen);position:sticky;top:0;
}
td{padding:2px 8px;color:var(--xc-text);border-bottom:1px solid #0f1a0a;cursor:pointer}
tr:hover td{background:#1a2a10;color:var(--xc-ltgreen)}
tr.s1 td{background:#0d2208;color:var(--xc-ltgreen)}
tr.s2 td{background:#2a0a08;color:#e06050}

/* ── label ── */
.field-lbl{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--xc-dimtext);margin-bottom:3px}
#msg{font-size:11px;letter-spacing:1px;color:var(--xc-amber)}
</style>
</head>
<body>

<!-- TOP BAR -->
<div class="topbar">
  <div>
    <div class="app-title">◈ MODULUS ANALYZER</div>
    <div style="font-size:9px;color:var(--xc-dimtext);letter-spacing:3px;margin-top:2px">STRAIN / STRESS TACTICAL UNIT v4.8</div>
  </div>
  <div class="branding">
    <b>SINISA SVOGER 2026 v4_8</b><br>
    FACULTY OF MECHANICAL ENGINEERING<br>
    UNIVERSITY OF MARIBOR
  </div>
</div>

<!-- DATA ENTRY -->
<div class="xc-panel">
  <div class="xc-title-bar">
    <span>▶ DATA INPUT MODULE</span>
    <span id="msg"></span>
  </div>
  <div class="row">
    <div>
      <div class="field-lbl">◈ Strain ε (%)</div>
      <textarea id="eIn" rows="5" style="width:100%" placeholder="0.001&#10;0.005&#10;..."></textarea>
